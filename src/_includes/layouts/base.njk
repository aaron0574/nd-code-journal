<!doctype html>
<html lang="{{ site.language }}">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	{%- set pageTitle = (title + " · " + site.title) if title and page.url != "/" else (site.title + " — " + site.tagline) %}
	<title>{{ pageTitle }}</title>
	<meta name="description" content="{{ description or site.description }}">
	<meta name="author" content="{{ site.author.name }}">
	<link rel="canonical" href="{{ page.url | htmlBaseUrl(site.url) }}">
	<meta property="og:type" content="{{ 'article' if layout == 'layouts/post.njk' else 'website' }}">
	<meta property="og:title" content="{{ title or site.title }}">
	<meta property="og:description" content="{{ description or site.description }}">
	<meta property="og:url" content="{{ page.url | htmlBaseUrl(site.url) }}">
	<meta name="color-scheme" content="light dark">
	<meta name="theme-color" content="#0c2340">
	<link rel="icon" href="/favicon.svg" type="image/svg+xml">
	<link rel="alternate" type="application/atom+xml" href="/feed.xml" title="{{ site.title }}">

	<link rel="preload" href="/assets/fonts/open-sans.woff2" as="font" type="font/woff2" crossorigin>
	<link rel="preload" href="/assets/fonts/ubuntu-700.woff2" as="font" type="font/woff2" crossorigin>

	<link rel="stylesheet" href="/assets/css/main.css">

	{# Apply saved theme before paint to avoid a flash #}
	<script>
		try { const t = localStorage.getItem("theme"); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
	</script>
	<script type="module" src="/assets/js/main.js"></script>
	{% block head %}{% endblock %}
</head>
<body class="{{ bodyClass }}">
	<a class="skip-link" href="#main">Skip to content</a>
	{% include "partials/header.njk" %}
	<main id="main" tabindex="-1">
		{{ content | safe }}
	</main>
	{% include "partials/footer.njk" %}
</body>
</html>
