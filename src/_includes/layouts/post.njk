---
layout: layouts/base.njk
bodyClass: is-post
---
{%- set topics = tags | topicsOnly -%}
{%- set lead = (topics[0] | topicMeta) if topics.length else ("html" | topicMeta) -%}
<article class="post" data-pagefind-body>
	<header class="post-header">
		<div class="wrap">
			<nav class="breadcrumbs" aria-label="Breadcrumb" data-pagefind-ignore>
				<ol role="list">
					<li><a href="/">Home</a></li>
					<li><a href="/articles/">Articles</a></li>
					{% if topics.length %}<li><a href="/topics/{{ topics[0] | slugify }}/">{{ lead.label }}</a></li>{% endif %}
				</ol>
			</nav>
			{% if draft %}<p class="draft-flag" data-pagefind-ignore>Draft · not visible on the live site</p>{% endif %}
			<h1 class="post-header__title">{{ title }}</h1>
			{% if description %}<p class="post-header__dek">{{ description }}</p>{% endif %}
			<div class="post-header__meta" data-pagefind-ignore>
				<div class="post-header__byline-group">
					<p class="post-header__byline">
						<span>By <strong>{{ site.author.name }}</strong></span>
						<span aria-hidden="true">·</span>
						<time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
						<span aria-hidden="true">·</span>
						<span>{{ content | readingTime }}</span>
					</p>
					{%- if site.comments.repoId and site.comments.categoryId and not draft %}
					<a class="reaction-summary" href="#comments" data-reaction-summary hidden>
						<span class="reaction-summary__counts" data-reaction-counts></span>
						<span class="reaction-summary__cta" data-reaction-cta>React or comment</span>
						<svg aria-hidden="true" viewBox="0 0 16 16" width="12" height="12"><path d="M8 3v10M4 9l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
					</a>
					{%- endif %}
				</div>
				<ul class="topic-labels" role="list">
					{%- for t in topics %}
					<li><a class="topic-label" data-color="{{ (t | topicMeta).color }}" href="/topics/{{ t | slugify }}/">{{ (t | topicMeta).label }}</a></li>
					{%- endfor %}
				</ul>
			</div>
		</div>
	</header>

	{# Hidden metadata for Pagefind search filters #}
	<div hidden>
		{%- for t in topics %}<span data-pagefind-filter="topic">{{ (t | topicMeta).label }}</span>{% endfor %}
		{%- for l in languages %}<span data-pagefind-filter="language">{{ l }}</span>{% endfor %}
		<span data-pagefind-meta="date">{{ page.date | shortDate }}</span>
		<span data-pagefind-meta="color">{{ lead.color }}</span>
		<span data-pagefind-sort="date">{{ page.date | isoDate }}</span>
	</div>

	<div class="wrap post-layout">
		<div class="prose">
			{{ content | safe }}
		</div>
		<aside class="post-aside" data-pagefind-ignore>
			<div class="post-aside__sticky">
				{%- if languages %}
				<section class="aside-box">
					<h2 class="aside-box__title">Stack</h2>
					<ul class="lang-list" role="list">{% for l in languages %}<li><span class="lang lang--lg">{{ l }}</span></li>{% endfor %}</ul>
				</section>
				{%- endif %}
				{%- if browserSupport %}
				<section class="aside-box">
					<h2 class="aside-box__title">Browser support</h2>
					<p>{{ browserSupport }}</p>
				</section>
				{%- endif %}
				<nav class="aside-box toc" aria-label="On this page" data-toc hidden>
					<h2 class="aside-box__title">On this page</h2>
					<ol role="list"></ol>
				</nav>
			</div>
		</aside>
	</div>
</article>

{%- if site.comments.repoId and site.comments.categoryId and not draft %}
<section class="comments" id="comments" aria-labelledby="comments-title" data-pagefind-ignore>
	<div class="wrap">
		<div class="comments__inner">
			<div class="section-head"><h2 id="comments-title" class="section-title"><span class="highlight">Discussion</span></h2></div>
			<p class="comments__intro">Questions, improvements, or a different approach? Comments use GitHub Discussions, so you'll sign in with a GitHub account, and code blocks work just like on GitHub.</p>
			<div class="comments__embed"
				data-giscus
				data-repo="{{ site.comments.repo }}"
				data-repo-id="{{ site.comments.repoId }}"
				data-category="{{ site.comments.category }}"
				data-category-id="{{ site.comments.categoryId }}">
				<noscript><p>Comments need JavaScript. You can also <a href="https://github.com/{{ site.comments.repo }}/discussions">join the discussion on GitHub</a>.</p></noscript>
			</div>
		</div>
	</div>
</section>
{%- endif %}

{%- set relatedPosts = collections.posts | related({ url: page.url, tags: tags }) -%}
{%- if relatedPosts.length %}
<section class="related" aria-labelledby="related-title">
	<div class="wrap">
		<div class="section-head"><h2 id="related-title" class="section-title"><span class="highlight">Keep reading</span></h2></div>
		<div class="card-grid">
			{%- for post in relatedPosts %}{% include "partials/card.njk" %}{% endfor %}
		</div>
	</div>
</section>
{%- endif %}
