<header class="site-header">
	<div class="wrap site-header__inner">
		<a class="brand" href="/" aria-label="{{ site.title }} home">
			<span class="brand__mark" aria-hidden="true">
				<svg viewBox="0 0 40 40" width="40" height="40"><rect width="40" height="40" rx="3" fill="currentColor"/><path d="M15 12l-7 8 7 8M25 12l7 8-7 8" fill="none" stroke="var(--gold)" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="20" cy="20" r="2.4" fill="var(--gold)"/></svg>
			</span>
			<span class="brand__name">{{ site.title }}</span>
		</a>

		<nav class="site-nav" aria-label="Main">
			<ul role="list">
				{%- for item in site.nav %}
				<li><a href="{{ item.url }}"{% if page.url.startsWith(item.url) %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
				{%- endfor %}
			</ul>
		</nav>

		<div class="site-header__tools">
			<form class="header-search" action="/search/" method="get" role="search">
				<label class="visually-hidden" for="header-q">Search articles</label>
				<svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M20 20l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
				<input id="header-q" name="q" type="search" placeholder="Search code…" autocomplete="off">
				<kbd aria-hidden="true">/</kbd>
			</form>
			<button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle dark mode" hidden>
				<svg class="icon-moon" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z" fill="currentColor"/></svg>
				<svg class="icon-sun" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></g></svg>
			</button>
		</div>
	</div>
</header>
