{#- Expects `post` and optional `variant` ("feature") -#}
{%- set topics = post.data.tags | topicsOnly -%}
{%- set topicText = topics | join(' ') -%}
{%- set searchText = [post.data.title, post.data.description, topicText, post.data.languages | join(' ')] | join(' ') -%}
<article class="card{% if variant %} card--{{ variant }}{% endif %}"
	data-card
	data-topics="{{ topicText }}"
	data-languages="{{ post.data.languages | join(' ') }}"
	data-date="{{ post.date | isoDate }}"
	data-title="{{ post.data.title | lower }}"
	data-text="{{ searchText | lower }}">
	{%- if topics.length %}
	<ul class="topic-labels" role="list">
		{%- for t in topics | limit(2) %}
		<li><a class="topic-label" data-color="{{ (t | topicMeta).color }}" href="/topics/{{ t | slugify }}/"><span class="label">{{ (t | topicMeta).label }}</span></a></li>
		{%- endfor %}
	</ul>
	{%- endif %}
	<h3 class="card__title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
	{%- if post.data.description %}<p class="card__excerpt">{{ post.data.description }}</p>{% endif %}
	<p class="card__meta">
		<time datetime="{{ post.date | isoDate }}">{{ post.date | shortDate }}</time>
		<span aria-hidden="true">·</span>
		<span>{{ post.content | readingTime }}</span>
		{%- if post.data.languages %}
		<span class="card__langs">{% for l in post.data.languages %}<span class="lang">{{ l }}</span>{% endfor %}</span>
		{%- endif %}
	</p>
</article>
