---
layout: layouts/base.njk
permalink: /
bodyClass: is-home
---
{%- set featured = collections.posts | first -%}
<section class="masthead">
	<div class="wrap masthead__inner">
		<div class="masthead__intro">
			<p class="eyebrow">{{ site.tagline }}</p>
			<h1 class="masthead__title">Code that shipped, written down so it ships again.</h1>
			<p class="masthead__dek">Snippets, patterns and small tools from building websites at the University of Notre Dame. Every example is real, tested, and ready to copy.</p>
			<form class="search-field search-field--lg" action="/search/" method="get" role="search">
				<label class="visually-hidden" for="hero-q">Search articles and code</label>
				<svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="1.75"/><path d="M20 20l-4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
				<input id="hero-q" name="q" type="search" placeholder="Search for “accordion”, “clamp” or “fetch”" autocomplete="off">
				<button type="submit" class="btn btn--primary">Search</button>
			</form>
			<p class="masthead__stats">{{ collections.posts.length }} articles <span aria-hidden="true">·</span> {{ collections.topics.length }} topics <span aria-hidden="true">·</span> {{ collections.languages.length }} languages</p>
		</div>
		{%- if featured %}
		<aside class="masthead__feature" aria-labelledby="latest-label">
			<p class="eyebrow" id="latest-label">Latest article</p>
			{% set post = featured %}{% set variant = "feature" %}{% include "partials/card.njk" %}{% set variant = "" %}
		</aside>
		{%- endif %}
	</div>
</section>

<nav class="topic-bar" aria-label="Browse by topic">
	<div class="wrap topic-bar__inner">
		<span class="topic-bar__label">Topics</span>
		<ul role="list">
			{%- for t in collections.topics %}
			<li><a class="topic-label" data-color="{{ (t.name | topicMeta).color }}" href="/topics/{{ t.slug }}/"><span class="label">{{ (t.name | topicMeta).label }}</span> <span class="count">{{ t.count }}</span></a></li>
			{%- endfor %}
		</ul>
	</div>
</nav>

<section class="home-section" aria-labelledby="latest-title">
	<div class="wrap">
		<div class="section-head">
			<h2 id="latest-title" class="section-title">Recent articles</h2>
			<a class="link-arrow" href="/articles/">All articles</a>
		</div>
		<div class="card-grid">
			{%- for post in collections.posts | exclude(featured) | limit(6) %}{% include "partials/card.njk" %}{% endfor %}
		</div>
	</div>
</section>

<section class="home-section" aria-labelledby="topics-title">
	<div class="wrap">
		<div class="section-head">
			<h2 id="topics-title" class="section-title">Browse by topic</h2>
			<a class="link-arrow" href="/topics/">All topics</a>
		</div>
		<ul class="topic-grid" role="list">
			{%- for t in collections.topics | limit(4) %}
			{%- set meta = t.name | topicMeta %}
			<li class="topic-tile" data-color="{{ meta.color }}">
				<h3><a href="/topics/{{ t.slug }}/">{{ meta.label }}</a></h3>
				<p>{{ meta.description }}</p>
				<ul role="list">
					{%- for p in t.posts | limit(3) %}<li><a href="{{ p.url }}">{{ p.data.title }}</a></li>{% endfor %}
				</ul>
				<span class="topic-tile__count">{{ t.count }} article{{ "s" if t.count != 1 }}</span>
			</li>
			{%- endfor %}
		</ul>
	</div>
</section>
