---
layout: layouts/base.njk
permalink: /
bodyClass: is-home
---
{%- set featured = collections.posts | first -%}
<section class="masthead" aria-labelledby="featured-title">
	<div class="wrap">
		<h1 class="visually-hidden">{{ site.title }}</h1>
		<p class="masthead__intro"><strong>{{ site.tagline }}.</strong> Accessible components, CSS, and hard-won solutions from building the University's websites.</p>
		{%- if featured %}
		{%- set topics = featured.data.tags | topicsOnly %}
		<article class="feature">
			<div class="feature__labels">
				<span class="feature__kicker">Latest article</span>
				<ul class="topic-labels" role="list">
					{%- for t in topics | limit(2) %}
					<li><a class="topic-label" data-color="{{ (t | topicMeta).color }}" href="/topics/{{ t | slugify }}/"><span class="label">{{ (t | topicMeta).label }}</span></a></li>
					{%- endfor %}
				</ul>
			</div>
			<div class="feature__grid">
				<h2 class="feature__title" id="featured-title"><a href="{{ featured.url }}">{{ featured.data.title }}</a></h2>
				<div class="feature__body">
					{%- if featured.data.description %}<p class="feature__desc">{{ featured.data.description }}</p>{% endif %}
					<p class="feature__meta">
						<time datetime="{{ featured.date | isoDate }}">{{ featured.date | readableDate }}</time>
						<span aria-hidden="true">·</span>
						<span>{{ featured.content | readingTime }}</span>
						{%- if featured.data.languages %}
						<span class="feature__langs">{% for l in featured.data.languages %}<span class="lang">{{ l }}</span>{% endfor %}</span>
						{%- endif %}
					</p>
					<a class="btn btn--gold feature__cta" href="{{ featured.url }}" aria-describedby="featured-title">Read the article <span aria-hidden="true">→</span></a>
				</div>
			</div>
		</article>
		{%- endif %}
	</div>
</section>

<nav class="topic-bar" aria-label="Browse by topic">
	<div class="wrap topic-bar__inner">
		<span class="topic-bar__label">Topics</span>
		<ul role="list">
			{%- for t in collections.topics %}
			<li><a class="topic-label" data-color="{{ (t.name | topicMeta).color }}" href="/topics/{{ t.slug }}/"><span class="label">{{ (t.name | topicMeta).label }}</span> <span class="count">{{ t.count }}</span></a></li>
			{%- endfor %}
		</ul>
	</div>
</nav>

<section class="home-section" aria-labelledby="latest-title">
	<div class="wrap">
		<div class="section-head">
			<h2 id="latest-title" class="section-title">Recent articles</h2>
			<a class="link-arrow" href="/articles/">All articles</a>
		</div>
		<div class="card-grid">
			{%- for post in collections.posts | exclude(featured) | limit(6) %}{% include "partials/card.njk" %}{% endfor %}
		</div>
	</div>
</section>

<section class="home-section" aria-labelledby="topics-title">
	<div class="wrap">
		<div class="section-head">
			<h2 id="topics-title" class="section-title"><span class="highlight">Browse by topic</span></h2>
			<a class="link-arrow" href="/topics/">All topics</a>
		</div>
		<ul class="topic-grid" role="list">
			{%- for t in collections.topics | limit(3) %}
			{%- set meta = t.name | topicMeta %}
			<li class="topic-tile" data-color="{{ meta.color }}">
				<h3><a href="/topics/{{ t.slug }}/">{{ meta.label }}</a></h3>
				<p>{{ meta.description }}</p>
				<ul role="list">
					{%- for p in t.posts | limit(3) %}<li><a href="{{ p.url }}">{{ p.data.title }}</a></li>{% endfor %}
				</ul>
				<span class="topic-tile__count">{{ t.count }} article{{ "s" if t.count != 1 }}</span>
			</li>
			{%- endfor %}
		</ul>
	</div>
</section>
